{
  "name": "cartridge-control",
  "productName": "CartridgeControl",
  "version": "1.1.17",
  "private": true,
  "type": "module",
  "description": "Система учёта картриджей с печатью этикеток",
  "author": "CartridgeControl",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run build && dotnet run --project native/CartridgeControl",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test:native": "dotnet run --project native/CartridgeControl.Tests",
    "test:desktop": "node tests/native-smoke.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "react": "19.2.3",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0"
  }
}
