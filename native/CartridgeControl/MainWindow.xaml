<Window x:Class="CartridgeControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="CartridgeControl — Система учёта картриджей" Width="1400" Height="900" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F9FAFB">
<DockPanel>
  <Menu DockPanel.Dock="Top">
    <MenuItem Header="Файл"><MenuItem Header="Перезагрузить" Click="Reload_Click" InputGestureText="Ctrl+R"/><Separator/><MenuItem Header="Выход" Click="Exit_Click" InputGestureText="Alt+F4"/></MenuItem>
    <MenuItem Header="Правка"><MenuItem Header="Отменить" Tag="undo" Click="Edit_Click"/><MenuItem Header="Повторить" Tag="redo" Click="Edit_Click"/><Separator/><MenuItem Header="Вырезать" Tag="cut" Click="Edit_Click"/><MenuItem Header="Копировать" Tag="copy" Click="Edit_Click"/><MenuItem Header="Вставить" Tag="paste" Click="Edit_Click"/><MenuItem Header="Выделить всё" Tag="selectAll" Click="Edit_Click"/></MenuItem>
    <MenuItem Header="Вид"><MenuItem Header="Уменьшить" Click="ZoomOut_Click"/><MenuItem Header="Увеличить" Click="ZoomIn_Click"/><MenuItem Header="Сбросить масштаб" Click="ZoomReset_Click"/><Separator/><MenuItem Header="Полный экран" Click="Fullscreen_Click" InputGestureText="F11"/><MenuItem Header="Инструменты разработчика" Click="DevTools_Click" InputGestureText="F12"/></MenuItem>
    <MenuItem Header="Помощь"><MenuItem Header="О программе" Click="About_Click"/></MenuItem>
  </Menu>
  <Grid><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#F9FAFB" />
    <StackPanel x:Name="StartupHelp" Visibility="Collapsed" MaxWidth="650" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="Не удалось открыть программу" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="StartupError" TextWrapping="Wrap" Margin="0,16"/>
      <TextBlock Text="Интерфейс использует Microsoft Edge WebView2 Runtime, как ThodHUB. Данные находятся в папке Data рядом с программой." TextWrapping="Wrap" Margin="0,8"/>
      <Button Content="Скачать WebView2 с сайта Microsoft" Click="WebViewDownload_Click" HorizontalAlignment="Left" Padding="12,8"/>
    </StackPanel>
  </Grid>
</DockPanel></Window>
